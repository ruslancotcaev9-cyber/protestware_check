{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protestware-check:schema:report-v1",
  "title": "Full CLI JSON report after policy application, schema 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "tool": {
      "const": "protestware-check"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "string"
    },
    "files_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "analysis_context": {
      "$ref": "#/$defs/analysisContext"
    },
    "scan": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "complete"
      ],
      "additionalProperties": true
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "risk": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "code_risk": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "info",
        "low",
        "medium",
        "high"
      ],
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "watchlists": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "live",
            "offline"
          ]
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "black_mark_accounts": {
          "type": "integer",
          "minimum": 0
        },
        "toxic_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "toxic_packages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": true
    },
    "malware_intel": {
      "$ref": "#/$defs/advisories"
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "lock",
            "registry"
          ]
        },
        "summary": {
          "$ref": "#/$defs/dependencySummary"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoryPackage"
          }
        },
        "go_builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goProvenance"
          }
        }
      },
      "required": [
        "mode",
        "summary",
        "packages",
        "go_builds"
      ],
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ast": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "auto",
            "required"
          ]
        },
        "parsed": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "disabled": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "parsed",
        "partial",
        "degraded",
        "disabled",
        "complete"
      ],
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "properties": {
        "configuration_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "only_new": {
          "type": "boolean"
        },
        "baseline_loaded": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "properties": {
            "active": {
              "type": "integer",
              "minimum": 0
            },
            "baseline": {
              "type": "integer",
              "minimum": 0
            },
            "suppressed": {
              "type": "integer",
              "minimum": 0
            },
            "disabled": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "active",
            "baseline",
            "suppressed",
            "disabled"
          ],
          "additionalProperties": true
        },
        "risk": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_context": {
          "$ref": "#/$defs/reviewContext"
        },
        "baseline_context_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_context_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "configuration_sha256",
        "only_new",
        "baseline_loaded",
        "counts",
        "risk",
        "warnings",
        "review_context",
        "baseline_context_match",
        "baseline_context_changes"
      ],
      "additionalProperties": true
    },
    "gate": {
      "type": "object",
      "properties": {
        "exit_code": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "fail_on": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "require_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "exit_code",
        "fail_on",
        "reasons",
        "require_complete"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "tool",
    "version",
    "source",
    "files_scanned",
    "analysis_context",
    "scan",
    "coverage",
    "risk",
    "code_risk",
    "summary",
    "findings",
    "watchlists",
    "malware_intel",
    "dependencies",
    "warnings",
    "ast",
    "policy",
    "gate"
  ],
  "additionalProperties": true,
  "description": "The native JSON output of the CLI, not the pre-policy build_report API result, SARIF or CycloneDX. schema versions the data contract; version identifies scanner code. Additive properties are allowed; unknown schema versions are rejected. Runtime semantic checks also verify counts, risk and gate consistency.",
  "$defs": {
    "analysisContext": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "source_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleset_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependencies_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "source_files",
        "source_digest",
        "ruleset_digest",
        "configuration_digest",
        "dependencies_digest"
      ],
      "additionalProperties": false
    },
    "reviewContext": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "source_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleset_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependencies_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "source_files",
        "source_digest",
        "ruleset_digest",
        "configuration_digest",
        "dependencies_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "integrity": {
          "type": "string"
        },
        "ambiguous": {
          "type": "boolean"
        },
        "module": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "packageIdentity": {
      "type": "object",
      "properties": {
        "ecosystem": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "direct": {
          "type": "boolean"
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build_context": {
          "type": "object"
        }
      },
      "required": [
        "ecosystem",
        "name",
        "version"
      ],
      "additionalProperties": true
    },
    "inventoryPackage": {
      "type": "object",
      "properties": {
        "ecosystem": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "depth": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "direct": {
          "type": "boolean"
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested": {
          "type": "string"
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "build_context": {
          "type": "object"
        }
      },
      "required": [
        "ecosystem",
        "name",
        "version",
        "manifest",
        "source",
        "depth",
        "direct",
        "repository",
        "requested",
        "via",
        "qualifiers",
        "origin",
        "build_context"
      ],
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ]
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline_state": {
          "enum": [
            "new",
            "unchanged",
            "updated"
          ]
        },
        "effective_severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ]
        },
        "policy_decision": {
          "enum": [
            "active",
            "baseline",
            "suppressed",
            "disabled"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "analysis": {
          "type": "string"
        },
        "resolved_symbol": {
          "type": "string"
        },
        "binding_certainty": {
          "enum": [
            "resolved",
            "possible"
          ]
        },
        "policy_review_required": {
          "type": "boolean"
        },
        "baseline_context_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_override": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "expires": {
              "type": "string"
            }
          },
          "required": [
            "owner",
            "reason",
            "expires"
          ],
          "additionalProperties": true
        },
        "policy_exception": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "expires": {
              "type": "string"
            }
          },
          "required": [
            "owner",
            "reason",
            "expires"
          ],
          "additionalProperties": true
        },
        "dataflow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "line",
              "kind",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "reachability": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "call_depth": {
              "type": "integer",
              "minimum": 0
            },
            "path_sensitive": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "package": {
          "$ref": "#/$defs/packageIdentity"
        },
        "matched_packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageIdentity"
          }
        },
        "advisory_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version_match": {
          "type": "string"
        },
        "origin_match": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "category",
        "severity",
        "file",
        "line",
        "message",
        "evidence",
        "fingerprint",
        "baseline_state",
        "effective_severity",
        "policy_decision",
        "confidence"
      ],
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "source",
            "artifact"
          ]
        },
        "enumeration": {
          "enum": [
            "provided",
            "local",
            "github"
          ]
        },
        "files_observed": {
          "type": "integer",
          "minimum": 0
        },
        "files_selected": {
          "type": "integer",
          "minimum": 0
        },
        "files_analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "file_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "pruned_directories": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "pruned_subtree_file_counts_unknown": {
          "type": "boolean"
        },
        "input_bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "analysis_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "file",
                  "directory"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "kind",
              "reason"
            ],
            "additionalProperties": true
          }
        },
        "samples_truncated": {
          "type": "boolean"
        },
        "ast_by_extension": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "resolved_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_tree": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profile",
        "enumeration",
        "files_observed",
        "files_selected",
        "files_analyzed",
        "file_counts",
        "pruned_directories",
        "pruned_subtree_file_counts_unknown",
        "input_bytes_read",
        "analysis_utf8_bytes",
        "samples",
        "samples_truncated",
        "ast_by_extension",
        "resolved_commit",
        "resolved_tree"
      ],
      "additionalProperties": true
    },
    "dependencySummary": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "ecosystems": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "identified_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "registry_requests": {
          "type": "integer",
          "minimum": 0
        },
        "go_unselected_checksums": {
          "type": "integer",
          "minimum": 0
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "go_build_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "profile_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "logical_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "manifests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "profile_id",
              "logical_digest",
              "manifests"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "count",
        "complete"
      ],
      "additionalProperties": true
    },
    "goProvenance": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "profile": {
          "type": "object",
          "properties": {
            "goos": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "goarch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "go_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "mod_mode": {
              "enum": [
                "readonly",
                "mod"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]+$"
              },
              "maxItems": 100
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "cgo_enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "goos",
            "goarch",
            "go_version",
            "mod_mode",
            "tags",
            "targets",
            "cgo_enabled"
          ],
          "additionalProperties": false
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
