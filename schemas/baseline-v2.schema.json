{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protestware-check:schema:baseline-v2",
  "title": "Reviewed baseline, schema 2, fingerprint version 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 2
    },
    "fingerprint_version": {
      "const": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "fingerprints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxItems": 50000
    },
    "context": {
      "$ref": "#/$defs/reviewContext"
    }
  },
  "required": [
    "schema",
    "fingerprint_version",
    "fingerprints",
    "context"
  ],
  "additionalProperties": true,
  "description": "A valid structure does not authorize filtering: source/rules/config/dependency/policy context must match. Additional top-level metadata is allowed; review-context fields are closed.",
  "$defs": {
    "reviewContext": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "source_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleset_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependencies_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "source_files",
        "source_digest",
        "ruleset_digest",
        "configuration_digest",
        "dependencies_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    }
  }
}
