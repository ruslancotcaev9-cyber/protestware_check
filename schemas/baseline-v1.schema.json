{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protestware-check:schema:baseline-v1",
  "title": "Legacy comparison-only baseline, schema 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "fingerprint_version": {
      "const": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "fingerprints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxItems": 50000
    }
  },
  "required": [
    "schema",
    "fingerprint_version",
    "fingerprints"
  ],
  "additionalProperties": true,
  "description": "Historical reader compatibility only. This baseline cannot be used with --only-new; review and regenerate schema 2."
}
